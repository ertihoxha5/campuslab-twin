meta {
  name: Login - University Admin
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{tenantAdminEmail}}",
    "password": "{{demoPassword}}",
    "rememberMe": true
  }
}

docs {
  Krijon sesion tenant me access dhe refresh cookie HttpOnly. Bruno e ruan cookie-n në cookie jar.
}

tests {
  test("Login-i tenant kalon", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().success).to.equal(true);
  });
  test("Përdoruesi i kthyer i përket universitetit", function () {
    expect(res.getBody().data.user.university).to.be.an("object");
  });
}
