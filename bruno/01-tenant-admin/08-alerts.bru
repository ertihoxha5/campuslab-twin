meta {
  name: List alerts
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/alerts?page=1&pageSize=20&laboratoryId={{laboratoryId}}
  body: none
  auth: none
}

docs {
  Alarmet aktive dhe historike të laboratorit. Alert lifecycle testohet veçmas me request mutating.
}

script:post-response {
  const body = res.getBody();
  const items = body.data?.alerts ?? body.data?.items ?? [];
  if (items[0]?.id) bru.setEnvVar("alertId", String(items[0].id));
}

tests {
  test("Alarmet kthehen", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
