docs {
  Ekzekutohet me sesionin e Universitetit A dhe ID reale të Universitetit B. Rezultati 404 nuk zbulon ekzistencën e burimit.
}

tests {
  test("Burimi cross-tenant fshihet me 404", function () {
    expect(res.getStatus()).to.equal(404);
  });
