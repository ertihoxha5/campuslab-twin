meta {
  name: Login - Lab Manager
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  { "email": "{{managerEmail}}", "password": "{{demoPassword}}" }
}

tests {
  test("Menaxheri kyçet", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.user.roles).to.include("lab_manager");
  });
}
