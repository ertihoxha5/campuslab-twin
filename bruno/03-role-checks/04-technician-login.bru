meta {
  name: Login - Technician
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  { "email": "{{technicianEmail}}", "password": "{{demoPassword}}" }
}

tests {
  test("Tekniku kyçet", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.user.roles).to.include("technician");
  });
}
