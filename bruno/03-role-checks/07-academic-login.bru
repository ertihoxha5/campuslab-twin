meta {
  name: Login - Academic Staff
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  { "email": "{{academicEmail}}", "password": "{{demoPassword}}" }
}

tests {
  test("Personeli akademik kyçet", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.user.roles).to.include("academic_staff");
  });
}
