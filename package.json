{
  "name": "campuslab-twin",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names CLIENT,SERVER --prefix-colors magenta,blue \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspace client && npm run build --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:rollback": "npm run db:rollback --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:verify": "npm run db:verify --workspace server",
    "db:maintain-readings": "npm run db:maintain-readings --workspace server",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=22"
  }
}
